  <diagram name="Additional Endpoints - Revise, Browse, Export" id="archextra">
    <mxGraphModel dx="1603" dy="898" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s2title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="GenAI Marketing Collateral API - Additional Endpoints Beyond the Brief&#39;s Literal Two (post-demo, 2026-07-31)" vertex="1">
          <mxGeometry height="30" width="1120" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="s2source" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Azure Table Storage - table &quot;articles&quot;  (the same table Sheet 1&#39;s POST /generate already writes to)&#xa;PartitionKey = sender_id__receiver_id, RowKey = article_id - read here via storage.get_article() / storage.list_articles()" vertex="1">
          <mxGeometry height="70" width="1080" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s2listep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="GET /articles endpoint&#xa;routers/articles.py: get_articles()&#xa;query params: sender_id, receiver_id" vertex="1">
          <mxGeometry height="70" width="280" x="40" y="180" as="geometry" />
        </mxCell>
        <mxCell id="s2listresp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="list_articles(sender_id, receiver_id)&#xa;-&gt; ArticleListResponse&#xa;articles: List[ArticleOutput], newest first&#xa;(both /generate and /revise rows included)&#xa;empty list, not 404, if none exist yet" vertex="1">
          <mxGeometry height="110" width="280" x="40" y="290" as="geometry" />
        </mxCell>
        <mxCell id="s2reviseep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="POST /articles/{article_id}/revise endpoint&#xa;routers/articles.py: revise_article()" vertex="1">
          <mxGeometry height="70" width="340" x="400" y="180" as="geometry" />
        </mxCell>
        <mxCell id="s2reviselookup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="get_article(article_id)&#xa;404 if article_id not found" vertex="1">
          <mxGeometry height="60" width="340" x="400" y="290" as="geometry" />
        </mxCell>
        <mxCell id="s2reviseassemble" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="assemble_revised_article(original, revision)&#xa;merges the edited fields onto the original;&#xa;sender_id / receiver_id / theme / image&#xa;blob_path+image_url are always taken from&#xa;the original - never from the request body" vertex="1">
          <mxGeometry height="100" width="340" x="400" y="370" as="geometry" />
        </mxCell>
        <mxCell id="s2revisevalidate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Pydantic validation (deterministic)&#xa;same _HeadlineSubheadlineCtaLimits +&#xa;BodySection word-limit validators&#xa;that POST /generate&#39;s LLMDraft uses" vertex="1">
          <mxGeometry height="90" width="340" x="400" y="490" as="geometry" />
        </mxCell>
        <mxCell id="s2revisesave" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="save_article() -&gt; new row&#xa;next version via get_next_version()&#xa;append-only, same pattern POST /generate&#xa;uses for regeneration - v1/v2/v3... coexist" vertex="1">
          <mxGeometry height="90" width="340" x="400" y="600" as="geometry" />
        </mxCell>
        <mxCell id="s2reviseresp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Response: ArticleOutput&#xa;(new article_id + incremented version)" vertex="1">
          <mxGeometry height="60" width="340" x="400" y="710" as="geometry" />
        </mxCell>
        <mxCell id="s2pdfep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="GET /articles/{article_id}/pdf endpoint&#xa;routers/articles.py: export_article_pdf()" vertex="1">
          <mxGeometry height="70" width="300" x="800" y="180" as="geometry" />
        </mxCell>
        <mxCell id="s2pdflookup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="get_article(article_id)&#xa;same lookup /revise uses - 404 if not found" vertex="1">
          <mxGeometry height="60" width="300" x="800" y="290" as="geometry" />
        </mxCell>
        <mxCell id="s2pdfbuild" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="pdf_export.build_pdf(article)&#xa;reportlab platypus flowables&#xa;(pure Python, no native system libs -&#xa;works on App Service unchanged)" vertex="1">
          <mxGeometry height="90" width="300" x="800" y="370" as="geometry" />
        </mxCell>
        <mxCell id="s2pdfimages" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="download_blob_bytes() for logo/hero images&#xa;real bytes embedded, best-effort;&#xa;falls back to a bracketed-caption placeholder&#xa;if the download fails or no blob_path exists" vertex="1">
          <mxGeometry height="100" width="300" x="800" y="490" as="geometry" />
        </mxCell>
        <mxCell id="s2pdfresp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Response: binary application/pdf&#xa;Content-Disposition: attachment&#xa;(the one non-JSON response in this API)" vertex="1">
          <mxGeometry height="70" width="300" x="800" y="620" as="geometry" />
        </mxCell>
        <mxCell id="s2note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="All 3 endpoints on this sheet are read-only or additive against articles Sheet 1&#39;s POST /generate already produced - none of them call /generate or /evaluate, and neither /generate nor /evaluate calls any of these. Deliberate scope additions beyond the brief&#39;s literal &quot;upload&quot; + &quot;generate&quot; pair (decision-log.md §19 revise, §20 PDF export), reusing Sheet 1&#39;s same append-only versioning and validate-before-persist discipline rather than inventing a second design." vertex="1">
          <mxGeometry height="80" width="1080" x="40" y="800" as="geometry" />
        </mxCell>
        <mxCell id="s2e1" edge="1" parent="1" source="s2source" target="s2listep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.13;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e2" edge="1" parent="1" source="s2source" target="s2reviseep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e3" edge="1" parent="1" source="s2source" target="s2pdfep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.87;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e4" edge="1" parent="1" source="s2listep" target="s2listresp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e5" edge="1" parent="1" source="s2reviseep" target="s2reviselookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e6" edge="1" parent="1" source="s2reviselookup" target="s2reviseassemble" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e7" edge="1" parent="1" source="s2reviseassemble" target="s2revisevalidate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e8" edge="1" parent="1" source="s2revisevalidate" target="s2revisesave" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2e9" edge="1" parent="1" source="s2revisesave" target="s2reviseresp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
