<mxfile host="Electron" pages="2">
  <diagram name="Solution Architecture and Pipeline Flow" id="arch">
    <mxGraphModel dx="1783" dy="898" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="GenAI Marketing Collateral API - Solution Architecture and Pipeline Flow" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="research" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" value="Research Agent (optional / design-only)&#xa;Web search + LLM summarization&#xa;visits Sender and Receiver websites" vertex="1">
          <mxGeometry height="70" width="220" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="contextpdfs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Context PDFs&#xa;Sender: offerings/differentiators&#xa;Receiver: pain points/challenges&#xa;(~2-4 pages each)" vertex="1">
          <mxGeometry height="70" width="220" x="320" y="60" as="geometry" />
        </mxCell>
        <mxCell id="uploadep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Upload Endpoint (1 of 3)&#xa;FastAPI backend&#xa;Pydantic request validation" vertex="1">
          <mxGeometry height="70" width="220" x="600" y="60" as="geometry" />
        </mxCell>
        <mxCell id="blobraw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Azure Blob Storage&#xa;Raw PDFs, keyed by document_id" vertex="1">
          <mxGeometry height="70" width="220" x="880" y="60" as="geometry" />
        </mxCell>
        <mxCell id="parsing" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Document Ingestion / Parsing Pipeline&#xa;Extract text, tables, images&#xa;(pymupdf / Azure Document Intelligence)" vertex="1">
          <mxGeometry height="70" width="220" x="880" y="180" as="geometry" />
        </mxCell>
        <mxCell id="blobimages" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Azure Blob Storage&#xa;Extracted images (separate blobs)" vertex="1">
          <mxGeometry height="70" width="220" x="1160" y="140" as="geometry" />
        </mxCell>
        <mxCell id="cosmos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Azure Table Storage (metadata store)&#xa;PartitionKey = sender_id__receiver_id, RowKey = document_id&#xa;parsed text + tables (JSON) + image blob-path refs" vertex="1">
          <mxGeometry height="80" width="220" x="880" y="300" as="geometry" />
        </mxCell>
        <mxCell id="generateep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Generate Endpoint (2 of 3)&#xa;FastAPI backend&#xa;fetch by sender_id + receiver_id" vertex="1">
          <mxGeometry height="80" width="220" x="600" y="300" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Build Prompt&#xa;system prompt + parsed context&#xa;+ Pydantic output schema" vertex="1">
          <mxGeometry height="80" width="220" x="320" y="300" as="geometry" />
        </mxCell>
        <mxCell id="aoai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Azure OpenAI Service (GPT-4o-mini)&#xa;single-shot, sequential generation&#xa;structured JSON output" vertex="1">
          <mxGeometry height="80" width="220" x="40" y="300" as="geometry" />
        </mxCell>
        <mxCell id="pydvalidate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Pydantic Validation (deterministic)&#xa;word limits, required fields, image slot count&#xa;internal to /generate only - auto-retry on failure" vertex="1">
          <mxGeometry height="80" width="220" x="40" y="420" as="geometry" />
        </mxCell>
        <mxCell id="storev1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="Store Generated Article (vN)&#xa;Blob Storage + Table Storage reference" vertex="1">
          <mxGeometry height="70" width="220" x="320" y="420" as="geometry" />
        </mxCell>
        <mxCell id="genresponse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Generate Response&#xa;structured JSON returned to caller&#xa;(/generate ends here - no auto-eval)" vertex="1">
          <mxGeometry height="70" width="220" x="320" y="510" as="geometry" />
        </mxCell>
        <mxCell id="evalep" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Evaluate Endpoint (3 of 3)&#xa;deterministic re-check +&#xa;LLM-as-judge (groundedness,&#xa;relevance, coherence)" vertex="1">
          <mxGeometry height="80" width="220" x="600" y="420" as="geometry" />
        </mxCell>
        <mxCell id="evalnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontSize=11;fontStyle=2;align=left;spacingLeft=6;" value="Generate and Evaluate are fully decoupled endpoints - no internal call either way. Connected only by a shared feedback contract: Evaluate&#39;s response.feedback has the same shape as Generate&#39;s request.feedback." vertex="1">
          <mxGeometry height="55" width="340" x="600" y="510" as="geometry" />
        </mxCell>
        <mxCell id="decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Score &gt;= threshold?" vertex="1">
          <mxGeometry height="90" width="180" x="880" y="415" as="geometry" />
        </mxCell>
        <mxCell id="refine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" value="Feedback -&gt; new /generate call&#xa;caller re-invokes /generate with&#xa;evaluate&#39;s feedback appended as&#xa;additional instructions (new version)" vertex="1">
          <mxGeometry height="90" width="220" x="1160" y="290" as="geometry" />
        </mxCell>
        <mxCell id="finalize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Evaluate Response: Passed&#xa;Serve structured JSON&#xa;(+ optional rendered artifact)" vertex="1">
          <mxGeometry height="70" width="220" x="1160" y="420" as="geometry" />
        </mxCell>
        <mxCell id="download" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Download / API Response&#xa;to end user" vertex="1">
          <mxGeometry height="70" width="200" x="1400" y="420" as="geometry" />
        </mxCell>
        <mxCell id="infraTitle" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;" value="Infrastructure and Cloud Services (Azure)" vertex="1">
          <mxGeometry height="30" width="500" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="infra1a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Hosting - Phase 1 (build/validate)&#xa;Azure App Service&#xa;git-push deploy, no Docker - prove&#xa;functionality is correct first" vertex="1">
          <mxGeometry height="90" width="260" x="40" y="640" as="geometry" />
        </mxCell>
        <mxCell id="infra1b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Hosting - Phase 2 (prod flavor)&#xa;Azure Container Apps&#xa;Dockerfile -&gt; ACR -&gt; revision;&#xa;shown deliberately " vertex="1">
          <mxGeometry height="90" width="260" x="340" y="640" as="geometry" />
        </mxCell>
        <mxCell id="infraHostArrow" edge="1" parent="1" source="infra1a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="infra1b" value="migrate once endpoints validated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="infraAKSnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=10;fontStyle=2;" value="AKS: production-scale alternative, described only -&#xa;cluster/networking overhead not justified for this timeline" vertex="1">
          <mxGeometry height="50" width="260" x="340" y="740" as="geometry" />
        </mxCell>
        <mxCell id="infra2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="IAM: Managed Identity + scoped RBAC&#xa;(no hardcoded secrets/connection strings)&#xa;- applies to both hosting phases" vertex="1">
          <mxGeometry height="90" width="280" x="640" y="640" as="geometry" />
        </mxCell>
        <mxCell id="infra3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="Secrets: Azure Key Vault for Azure OpenAI key&#xa;(read via Managed Identity; optionally skip the&#xa;key entirely via Entra ID auth to Azure OpenAI)" vertex="1">
          <mxGeometry height="90" width="300" x="960" y="640" as="geometry" />
        </mxCell>
        <mxCell id="infra4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="API exposure: App Service default domain (Phase 1)&#xa;-&gt; Container Apps built-in ingress (Phase 2)&#xa;(future: Azure API Management for auth/rate-limiting)" vertex="1">
          <mxGeometry height="90" width="300" x="1300" y="640" as="geometry" />
        </mxCell>
        <mxCell id="infra5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="CI/CD (two-phase): GitHub Actions -&gt; Azure App Service (zip/git deploy, Phase 1)&#xa;then GitHub Actions -&gt; Azure Container Registry (ACR) -&gt; Container App revision update (Phase 2), both on push to main" vertex="1">
          <mxGeometry height="80" width="900" x="40" y="810" as="geometry" />
        </mxCell>
