        <mxCell id="n38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="Pydantic validation (LLMDraft validators)&#xa;word limits, 2-3 body_sections, etc.&#xa;ON FAIL: ValidationError text fed back as&#xa;feedback -&gt; retry (1 retry, then RuntimeError -&gt; 502)" vertex="1">
          <mxGeometry height="90" width="300" x="900" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="n42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="5. resolve_image_slots(sender_ctx, receiver_ctx, draft)&lt;br&gt;draft itself has NO image_slots field — only 3 caption&lt;br&gt;strings (sender_logo_caption, receiver_logo_caption,&lt;br&gt;contextual_image_caption). image_slots[] is built fresh,&lt;br&gt;right here, from those captions + sender/receiver_ctx&#39;s&lt;br&gt;image_paths. logo_sender/receiver: first image per side.&lt;br&gt;hero_contextual: caption only, blob_path=None (known gap). &lt;i&gt;Produces exactly 3 ImageSlot objects.&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="900" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="n44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="6. storage.get_image_url() &lt;i&gt;i.e.&amp;nbsp;image_url=get_image_url(receiver_logo_path)&lt;/i&gt;&lt;br&gt;Blob: extracted-images (Storage Account)&lt;br&gt;SAS token, read-only, 6h expiry&lt;br&gt;(minted fresh every call, not cached)" vertex="1">
          <mxGeometry height="90" width="300" x="900" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="storage.get_next_version()&#xa;reads Table: articles&#xa;PartitionKey = {sender}__{receiver}&#xa;max(version) + 1  (1 if none exist)" vertex="1">
