          </mxGeometry>
        </mxCell>
        <mxCell id="lane23" parent="1" style="swimlane;html=1;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;spacingLeft=10;fontColor=#333333;" value="POST /generate  —  app/routers/generate.py + app/generation.py  (application/json)" vertex="1">
          <mxGeometry height="840" width="1940" x="20" y="610" as="geometry" />
        </mxCell>
        <mxCell id="5silZvYX7goSeBLVEoFY-1" parent="lane23" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;dashed=1;" value="&lt;strong&gt;Resolve Image Slots&lt;/strong&gt; — deterministic, no LLM. Builds 3 fixed slots in order: &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;logo_sender&lt;/code&gt; (first image in sender PDF), &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;logo_receiver&lt;/code&gt; (first image in receiver PDF), &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;hero_contextual&lt;/code&gt; (no source yet - known gap, path stubbed &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;None&lt;/code&gt;). Logo detection is positional (assumes logo = first extracted image), not classified." vertex="1">
          <mxGeometry height="90" width="300" x="570" y="550" as="geometry" />
        </mxCell>
        <mxCell id="badge_n50" parent="lane23" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontColor=#9673a6;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;dashed=0;" value="Ⓟ Pydantic model" vertex="1">
          <mxGeometry height="16" width="92" x="60" y="654" as="geometry" />
        </mxCell>
        <mxCell id="lane54" parent="1" style="swimlane;html=1;horizontal=1;startSize=26;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;align=left;spacingLeft=10;fontColor=#333333;" value="POST /evaluate  —  app/routers/evaluate.py + app/evaluation.py  (application/json)" vertex="1">
