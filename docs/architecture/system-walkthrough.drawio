        <mxCell id="e19" edge="1" parent="lane8" source="n16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="n18" value="4. save_document_metadata()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14b" parent="lane8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="PyMuPDF (fitz): _extract_images()&amp;#xa;IMAGES ONLY — not text, not tables.&amp;#xa;page.get_images(full=True) scans the page&#39;s&amp;#xa;content stream for embedded raster images,&amp;#xa;returns each one&#39;s xref (a pointer into the PDF&#39;s&amp;#xa;internal object table — not the image data itself).&amp;#xa;doc.extract_image(xref) follows that pointer and&amp;#xa;returns already-decoded real image bytes (e.g.&amp;#xa;actual PNG/JPEG bytes) + the file extension.&amp;#xa;Not base64, not markdown — same bytes as saving&amp;#xa;that picture as its own file." vertex="1">
          <mxGeometry height="190" width="300" x="940" y="220" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="lane8" source="n14b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.15;entryX=0;entryY=0.7;" target="n16" value="3. upload_extracted_images()">
          <mxGeometry relative="1" x="-0.1632" y="20" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n14" parent="lane8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="pdfplumber: _extract_text_and_tables()&amp;#xa;TEXT: page.extract_text() — stitches every&amp;#xa;character&#39;s position back into reading-order text.&amp;#xa;TABLES: page.extract_tables() — a layout&amp;#xa;heuristic, NOT OCR, NOT an LLM: reads the page&#39;s&amp;#xa;ruled lines (or, absent those, consistent gaps/&amp;#xa;alignment between text tokens) to infer a row/&amp;#xa;column grid, then buckets tokens into cells.&amp;#xa;Reliable here because these are born-digital PDFs&amp;#xa;with real vector-drawn table borders (reportlab) —&amp;#xa;a scanned PDF would need OCR first (not done here)." vertex="1">
          <mxGeometry height="190" width="300" x="540" y="220" as="geometry" />
        </mxCell>
        <mxCell id="e14b" edge="1" parent="lane8" source="n14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="n14b" value="then _extract_images()&#xa;(same parse_pdf() call)">
          <mxGeometry relative="1" y="-25" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e14direct" edge="1" parent="lane8" source="n14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="n18" value="text + tables_json&#xa;(straight into the table row,&#xa;never touches Blob Storage)">
          <mxGeometry relative="1" x="-0.025" y="-30" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="690" y="430" />
              <mxPoint x="1470" y="430" />
