        <mxCell id="n27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="sender_ctx = storage.fetch_context(role=&quot;sender&quot;)&lt;br&gt;reads Table: documentmetadata&lt;br&gt;filter: PartitionKey eq &#39;{sender}__{receiver}&#39;&lt;br&gt;        and role eq &#39;sender&#39;&lt;br&gt;dedup: exact full-text match via a hash set&lt;br&gt;(set membership, O(n) overall - NOT pairwise O(n²))" vertex="1">
          <mxGeometry height="90" width="270" x="540" y="655" as="geometry" />
        </mxCell>
        <mxCell id="n28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" value="receiver_ctx = storage.fetch_context(role=&quot;receiver&quot;)&lt;br&gt;reads Table: documentmetadata&lt;br&gt;filter: PartitionKey eq &#39;{sender}__{receiver}&#39;&lt;br&gt;        and role eq &#39;receiver&#39;&lt;br&gt;dedup: same hash-set check as sender, O(n)&lt;br&gt;returns text + tables + image blob PATHS only —&lt;br&gt;no bytes fetched from Blob Storage at this point" vertex="1">
          <mxGeometry height="110" width="270" x="540" y="770" as="geometry" />
