# Copy to .env for local development. Never commit the real .env file (already in .gitignore).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_STORAGE_CONNECTION_STRING=

# Application Insights — optional locally (telemetry just no-ops if unset), required in
# Azure App Service Configuration for the deployed app's requests/dependencies/traces to
# show up in Application Insights. Copy from the App Insights resource's Overview page.
APPLICATIONINSIGHTS_CONNECTION_STRING=